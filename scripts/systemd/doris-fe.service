[Unit]
Description=Apache Doris Frontend (FE)
Documentation=https://doris.apache.org
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=doris
Group=doris
PIDFile=/opt/doris/fe/bin/fe.pid
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
Environment=DORIS_HOME=/opt/doris/fe
ExecStart=/opt/doris/fe/bin/start_fe.sh --daemon
ExecStop=/opt/doris/fe/bin/stop_fe.sh --grace
KillSignal=SIGTERM
SendSIGKILL=yes
TimeoutStartSec=180
TimeoutStopSec=180
Restart=on-failure
RestartSec=15
LimitNOFILE=655360
LimitNPROC=655360

[Install]
WantedBy=multi-user.target
