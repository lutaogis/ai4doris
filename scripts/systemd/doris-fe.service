[Unit]
Description=Apache Doris Frontend (FE)
Documentation=https://doris.apache.org
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=doris
Group=doris
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ExecStart=/opt/doris/fe/bin/start_fe.sh --daemon
ExecStop=/opt/doris/fe/bin/stop_fe.sh
LimitNOFILE=655360
LimitNPROC=655360
Restart=on-failure
RestartSec=15
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
