# ============================================================
# 集群节点清单 —— 所有脚本统一 source 本文件
# 修改 IP/主机名只需改这里
# ============================================================

DORIS_VERSION="4.0.8"
DORIS_HOME="/opt/doris"
PKG_DIR="/opt/doris/pkg"
DORIS_USER="doris"

# 网段（fe.conf / be.conf 的 priority_networks）
NET_PREFIX="192.168.1.0/24"

# FE 首节点（部署起点，也是初始 Master）
FE_LEADER_HOST="doris-node-01"
FE_LEADER_IP="192.168.1.51"

# 全部节点：主机名:IP:角色
ALL_NODES=(
  "doris-node-01:192.168.1.51:fe"
  "doris-node-02:192.168.1.52:fe"
  "doris-node-03:192.168.1.53:fe"
  "doris-node-04:192.168.1.54:be"
  "doris-node-05:192.168.1.55:be"
  "doris-node-06:192.168.1.56:be"
)

# mysql 客户端参数
# 若 MySQL 8.0 客户端连 9030 报 caching_sha2 认证错误，把下一行改成
#   MYSQL_AUTH_OPT="--default-auth=mysql_native_password"
MYSQL_AUTH_OPT=""

# root 密码（2026-11-01 部署时设置；脚本用它登录 9030）
MYSQL_ROOT_PASSWORD="Doris@2026"

# 巡检脚本用 ssh 采集主机层指标（06-inspect.sh --no-ssh 可跳过）
NODE_SSH_USER="lumz"
NODE_SSH_PASSWORD="lumz1021"
